<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:RA3_Launcher.ViewModels"
			 xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
			 x:Class="RA3_Launcher.Views.MainView"
			 xmlns:dm="using:RA3_Launcher.Managers.DialogsManager"
			 x:DataType="vm:MainViewModel">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="*, Auto">
		<Rectangle Grid.Row="0" Fill="{DynamicResource ThemeBackgroundBrush}" />

		<StackPanel Grid.Row="0"
					Orientation="Horizontal"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Margin="20,20,20,0">
			<Border Background="{DynamicResource ThemeBackgroundBrush}"
					Opacity="0.8"
					CornerRadius="8"
					Padding="10,5">
				<TextBlock Text="{Binding CurrentVersion}"
						   FontWeight="SemiBold"
						   FontSize="14"
						   Foreground="{DynamicResource ControlPrimaryForegroundBrush}" />
			</Border>
		</StackPanel>

		<husk:Card
		Grid.Row="1"
		MinWidth="400"
		MaxWidth="500"
		Margin="0,0,0,30"
		HorizontalAlignment="Center"
		VerticalAlignment="Bottom" Opacity="0.9">

			<StackPanel Spacing="20"
						Background="{DynamicResource ThemeBackgroundBrush}"
						>

				<!-- Внутренний StackPanel с кнопками -->
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Center"
							Spacing="15">

					<!-- Settings Button -->
					<Button Classes="Primary"
							Command="{Binding OpenSettingsCommand}"
							Width="48"
							Height="48"
							Theme="{StaticResource OutlineButtonTheme}"
							ToolTip.Tip="Настройки">
						<fi:SymbolIcon Symbol="Settings"
									   Height="20"
									   Width="20" />
					</Button>

					<!-- Launch Game Button -->
					<Button Classes="Primary"
							Command="{Binding LaunchGameCommand}"
							Content="Launch Game"
							Width="160"
							Height="48"
							Theme="{StaticResource OutlineButtonTheme}"
							FontSize="14"
							FontWeight="SemiBold"
							ToolTip.Tip="Запустить игру" />

					<!-- Mods Button -->
					<Button Classes="Primary"
							Command="{Binding OpenModsCommand}"
							Width="48"
							Height="48"
							Theme="{StaticResource OutlineButtonTheme}"
							ToolTip.Tip="Модификации">
						<fi:SymbolIcon Symbol="WrenchScrewdriver"
									   Height="20"
									   Width="20" />
					</Button>
				</StackPanel>

				<!-- Выбор мода -->
				<Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
					<TextBlock Grid.Column="0"
							   Text="Select Mod"
							   FontWeight="SemiBold"
							   FontSize="14"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource ControlPrimaryForegroundBrush}" />

					<ComboBox Grid.Column="1"
							  HorizontalContentAlignment="Left"
							  VerticalContentAlignment="Center"
							  ItemsSource="{Binding AvailableMods}"
							  SelectedItem="{Binding SelectedMod}"
							  DisplayMemberBinding="{Binding NameAndVersion}"
							  MinWidth="150"
							  Height="40"
							  HorizontalAlignment="Stretch"
							  BorderThickness="1"
							  BorderBrush="{DynamicResource ControlAccentBrush}"
							  CornerRadius="6" />
				</Grid>

			</StackPanel>
		</husk:Card>
	</Grid>
</UserControl>