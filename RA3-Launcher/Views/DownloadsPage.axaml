<husk:Page xmlns="https://github.com/avaloniaui"
		   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		   xmlns:mod="using:Items.Mod"
		   xmlns:viewmodels="using:ViewModels"
		   mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		   xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
		   xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
		   x:DataType="viewmodels:DownloadViewModel"
		   x:Class="RA3_Launcher.Views.DownloadsPage">

	<Grid RowDefinitions="Auto, *" RowSpacing="5">
		<husk:Card Grid.Row="0" Margin="10">
			<TabControl Padding="0" TabStripPlacement="Top" Classes="Primary" Theme="{StaticResource SolidTabControlTheme}">
				<TabItem Classes="Primary">
					<TabItem.Header>
						<husk:IconLabel Icon="WrenchScrewdriver" Text="Mods"/>
					</TabItem.Header>
				</TabItem>

				<TabItem Classes="Primary">
					<TabItem.Header>
						<husk:IconLabel Icon="Map" Text="Maps"/>
					</TabItem.Header>
				</TabItem>
			</TabControl>
		</husk:Card>
		<husk:Card Grid.Row="1" Margin="10,0,10,10">
			<ItemsControl ItemsSource="{Binding AvailableMods}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="mod:Mod">
						<husk:Card PointerPressed="ModInfo_PointerPressed" DataContext="{Binding}"
								   Padding="16"
								   MaxWidth="280"
								   MinHeight="200"
								   MaxHeight="250"
								   Background="{DynamicResource CardBackgroundBrush}">
							<Grid RowDefinitions="Auto,Auto,1*,Auto">
								<!-- Заголовок -->
								<TextBlock Grid.Row="0"
										   Text="{Binding Name}"
										   FontWeight="{StaticResource ControlStrongFontWeight}"
										   FontSize="{StaticResource LargeFontSize}"
										   TextTrimming="CharacterEllipsis"
										   ToolTip.Tip="{Binding Name}" />

								<!-- Разделитель -->
								<husk:Divider Grid.Row="1" Margin="0,8" />

								<!-- Описание (ограничено 3 строками) -->
								<TextBlock Grid.Row="2"
										   Text="{Binding Description}"
										   TextWrapping="Wrap"
										   MaxLines="3"
										   LineHeight="18"
										   Foreground="{StaticResource ControlSecondaryForegroundBrush}"
										   ToolTip.Tip="{Binding Description}" />

								<!-- Кнопки -->
								<StackPanel Grid.Row="3"
											Orientation="Horizontal"
											Spacing="8"
											Margin="0,12,0,0">
									<Button Classes="Primary"
											HorizontalAlignment="Left"
											Command="{Binding DownloadCommand}">
										<husk:IconLabel Text="Скачать" Icon="ArrowDownload" />
									</Button>
									<Button Classes="Danger"
											HorizontalAlignment="Right"
											Command="{Binding DeleteCommand}">
										<husk:IconLabel Text="Удалить" Icon="Delete" />
									</Button>
								</StackPanel>
							</Grid>
						</husk:Card>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</husk:Card>
	</Grid>

</husk:Page>
