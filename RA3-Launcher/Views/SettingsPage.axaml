<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:RA3_Launcher.ViewModels"
		xmlns:gb="using:GroupBox.Avalonia.Controls"
		xmlns:i="https://github.com/avaloniaui"
		mc:Ignorable="d"
		d:DesignWidth="500"
		d:DesignHeight="650"
		x:Class="RA3_Launcher.Views.SettingsPage"
		MinWidth="550"
		MinHeight="650"
		MaxWidth="550"
		MaxHeight="650"
		Title="Настройки"
		x:DataType="vm:SettingsViewModel"
		Background="{DynamicResource BackgroundBrush}"
		Foreground="{DynamicResource TextBrush}">

	<Design.DataContext>
		<vm:SettingsViewModel />
	</Design.DataContext>

	<Border Background="{DynamicResource BackgroundBrush}"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="1"
			CornerRadius="12">
		<ScrollViewer Padding="20"
					  VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="24" Orientation="Vertical">

				<!-- Header -->
				<TextBlock Text="Настройки"
						   FontSize="24"
						   FontWeight="Bold"
						   Foreground="{DynamicResource AccentBrush}"
						   HorizontalAlignment="Center"
						   Margin="0,0,0,10"/>

				<!-- Launch Options Section -->
				<Border Theme="{StaticResource CardBorderStyle}" Padding="16">
					<StackPanel Spacing="12">
						<TextBlock Text="Параметры запуска"
								   FontWeight="SemiBold"
								   FontSize="16"
								   Foreground="{DynamicResource HeaderBrush}"/>

						<TextBox Name="LaunchOptionsTextBox"
								 Text="{Binding LaunchOptions, Mode=TwoWay}"
								 Watermark="Введите параметры запуска, например, -windowed -res 1280x720"
								 FontSize="13"
								 Padding="12,10"
								 Background="{DynamicResource InputBackgroundBrush}"
								 BorderBrush="{DynamicResource InputBorderBrush}"
								 BorderThickness="1"
								 CornerRadius="6"
								 Foreground="{DynamicResource TextBrush}"/>
					</StackPanel>
				</Border>

				<!-- Game Path Section -->
				<Border Theme="{StaticResource CardBorderStyle}" Padding="16">
					<StackPanel Spacing="12">
						<TextBlock Text="Путь к игре"
								   FontWeight="SemiBold"
								   FontSize="16"
								   Foreground="{DynamicResource HeaderBrush}"/>

						<Grid ColumnDefinitions="*, Auto" RowSpacing="8">
							<TextBox Name="GamePathTextBox"
									 Text="{Binding GamePath, Mode=TwoWay}"
									 Watermark="C:\Games\Red Alert 3\ra3.exe"
									 FontSize="13"
									 Padding="12,10"
									 Background="{DynamicResource InputBackgroundBrush}"
									 BorderBrush="{DynamicResource InputBorderBrush}"
									 BorderThickness="1"
									 CornerRadius="6"
									 Foreground="{DynamicResource TextBrush}"/>
							<Button Name="BrowseGamePathButton"
									Grid.Column="1"
									Margin="12,0,0,0"
									Content="Обзор..."
									Classes="Primary"
									Padding="16,8"
									CornerRadius="6"/>
						</Grid>
					</StackPanel>
				</Border>

				<!-- Additional Tools Section -->
				<Border Theme="{StaticResource CardBorderStyle}" Padding="16">
					<StackPanel Spacing="12">
						<TextBlock Text="Дополнительные инструменты"
								   FontWeight="SemiBold"
								   FontSize="16"
								   Foreground="{DynamicResource HeaderBrush}"/>

						<UniformGrid Columns="2" RowSpacing="12" ColumnSpacing="12">
							<!-- 4GB Patch Button with Info -->
							<Border Background="{DynamicResource InputBackgroundBrush}"
									CornerRadius="6"
									Padding="4">
								<DockPanel>
									<Button Name="Apply4GBPatchButton"
											Content="4GB Patch"
											Classes="Primary"
											Padding="8,10"
											CornerRadius="4"
											HorizontalAlignment="Stretch"
											DockPanel.Dock="Left"
											HorizontalContentAlignment="Left"
											Margin="0,0,4,0"/>
									<Button Classes="Ghost"
											DockPanel.Dock="Right"
											Padding="6,2"
											CornerRadius="4"
											Background="Transparent"
											BorderThickness="0">
										<TextBlock Text="?"
												   FontSize="10"
												   FontWeight="Bold"
												   VerticalAlignment="Center"
												   HorizontalAlignment="Center"
												   Foreground="{DynamicResource AccentBrush}"/>
										<ToolTip.Tip>
											<TextBlock Text="{Binding FourGBPatchDescriptionProperty}"
													   TextWrapping="Wrap"
													   MaxWidth="250"/>
										</ToolTip.Tip>
									</Button>
								</DockPanel>
							</Border>

							<!-- Fix Registry Button with Info -->
							<Border Background="{DynamicResource InputBackgroundBrush}"
									CornerRadius="6"
									Padding="4">
								<DockPanel>
									<Button Name="FixRegistryButton"
											Content="Фикс реестра"
											Classes="Primary"
											Padding="8,10"
											CornerRadius="4"
											HorizontalAlignment="Stretch"
											DockPanel.Dock="Left"
											HorizontalContentAlignment="Left"
											Margin="0,0,4,0"/>
									<Button Classes="Ghost"
											DockPanel.Dock="Right"
											Padding="6,2"
											CornerRadius="4"
											Background="Transparent"
											BorderThickness="0">
										<TextBlock Text="?"
												   FontSize="10"
												   FontWeight="Bold"
												   VerticalAlignment="Center"
												   HorizontalAlignment="Center"
												   Foreground="{DynamicResource AccentBrush}"/>
										<ToolTip.Tip>
											<TextBlock Text="{Binding RegistryFixDescriptionProperty}"
													   TextWrapping="Wrap"
													   MaxWidth="250"/>
										</ToolTip.Tip>
									</Button>
								</DockPanel>
							</Border>

							<!-- BattleNet Button with Info -->
							<Border Background="{DynamicResource InputBackgroundBrush}"
									CornerRadius="6"
									Padding="4">
								<DockPanel>
									<Button Name="InstallBattleNetButton"
											Content="BattleNet"
											Classes="Primary"
											Padding="8,10"
											CornerRadius="4"
											HorizontalAlignment="Stretch"
											DockPanel.Dock="Left"
											HorizontalContentAlignment="Left"
											Margin="0,0,4,0"/>
									<Button Classes="Ghost"
											DockPanel.Dock="Right"
											Padding="6,2"
											CornerRadius="4"
											Background="Transparent"
											BorderThickness="0">
										<TextBlock Text="?"
												   FontSize="10"
												   FontWeight="Bold"
												   VerticalAlignment="Center"
												   HorizontalAlignment="Center"
												   Foreground="{DynamicResource AccentBrush}"/>
										<ToolTip.Tip>
											<TextBlock Text="{Binding BattleNetDescriptionProperty}"
													   TextWrapping="Wrap"
													   MaxWidth="250"/>
										</ToolTip.Tip>
									</Button>
								</DockPanel>
							</Border>

							<!-- CnC Online Button with Info -->
							<Border Background="{DynamicResource InputBackgroundBrush}"
									CornerRadius="6"
									Padding="4">
								<DockPanel>
									<Button Name="InstallCnCOnlineButton"
											Content="CnC Online"
											Classes="Primary"
											Padding="8,10"
											CornerRadius="4"
											HorizontalAlignment="Stretch"
											DockPanel.Dock="Left"
											HorizontalContentAlignment="Left"
											Margin="0,0,4,0"/>
									<Button Classes="Ghost"
											DockPanel.Dock="Right"
											Padding="6,2"
											CornerRadius="4"
											Background="Transparent"
											BorderThickness="0">
										<TextBlock Text="?"
												   FontSize="10"
												   FontWeight="Bold"
												   VerticalAlignment="Center"
												   HorizontalAlignment="Center"
												   Foreground="{DynamicResource AccentBrush}"/>
										<ToolTip.Tip>
											<TextBlock Text="{Binding CnCOnlineDescriptionProperty}"
													   TextWrapping="Wrap"
													   MaxWidth="250"/>
										</ToolTip.Tip>
									</Button>
								</DockPanel>
							</Border>

							<!-- Radmin VPN Button with Info -->
							<Border Background="{DynamicResource InputBackgroundBrush}"
									CornerRadius="6"
									Padding="4">
								<DockPanel>
									<Button Name="InstallRadminVPNButton"
											Content="Radmin VPN"
											Classes="Primary"
											Padding="8,10"
											CornerRadius="4"
											HorizontalAlignment="Stretch"
											DockPanel.Dock="Left"
											HorizontalContentAlignment="Left"
											Margin="0,0,4,0"/>
									<Button Classes="Ghost"
											DockPanel.Dock="Right"
											Padding="6,2"
											CornerRadius="4"
											Background="Transparent"
											BorderThickness="0">
										<TextBlock Text="?"
												   FontSize="10"
												   FontWeight="Bold"
												   VerticalAlignment="Center"
												   HorizontalAlignment="Center"
												   Foreground="{DynamicResource AccentBrush}"/>
										<ToolTip.Tip>
											<TextBlock Text="{Binding RadminVPNDescriptionProperty}"
													   TextWrapping="Wrap"
													   MaxWidth="250"/>
										</ToolTip.Tip>
									</Button>
								</DockPanel>
							</Border>
						</UniformGrid>
					</StackPanel>
				</Border>

				<!-- Update Settings Section -->
				<Border Theme="{StaticResource CardBorderStyle}" Padding="16">
					<StackPanel Spacing="16">
						<TextBlock Text="Настройки обновлений"
								   FontWeight="SemiBold"
								   FontSize="16"
								   Foreground="{DynamicResource HeaderBrush}"/>

						<StackPanel Spacing="10">
							<CheckBox Name="CheckUpdatesForModsCheckBox"
									  IsChecked="{Binding CheckUpdatesForMods, Mode=TwoWay}"
									  Content="Проверять наличие обновлений модификаций при запуске"
									  FontSize="13"
									  Foreground="{DynamicResource TextBrush}"
									  Background="{DynamicResource InputBackgroundBrush}"
									  BorderBrush="{DynamicResource InputBorderBrush}"/>
							<CheckBox Name="CheckUpdatesForAppCheckBox"
									  IsChecked="{Binding CheckUpdatesForApp, Mode=TwoWay}"
									  Content="Проверять наличие обновлений лаунчера при запуске"
									  FontSize="13"
									  Foreground="{DynamicResource TextBrush}"
									  Background="{DynamicResource InputBackgroundBrush}"
									  BorderBrush="{DynamicResource InputBorderBrush}"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Save Button -->
				<Button Name="SaveSettingsButton"
						Content="Сохранить настройки"
						Classes="Primary"
						HorizontalAlignment="Stretch"
						Margin="0,10,0,0"
						Height="50"
						FontSize="15"
						FontWeight="SemiBold"
						CornerRadius="8"
						Padding="16,0"/>

			</StackPanel>
		</ScrollViewer>
	</Border>
</Window>